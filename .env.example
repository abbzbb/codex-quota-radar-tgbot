TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 建议填写允许访问的 Telegram chat_id，多个用英文逗号分隔
# 留空表示不限制访问，但不推荐
ALLOWED_CHAT_IDS=123456789

# Telegram API 代理（网络无法直连 api.telegram.org 时使用；HTTP 代理示例：http://127.0.0.1:7890）
TELEGRAM_PROXY=
TELEGRAM_CONNECT_TIMEOUT=20
TELEGRAM_READ_TIMEOUT=20
TELEGRAM_WRITE_TIMEOUT=20
TELEGRAM_POOL_TIMEOUT=5

# Codex app-server 命令
CODEX_CMD=codex app-server --listen stdio://
RPC_TIMEOUT_SECONDS=60

# Codex/ChatGPT 网络代理（Codex CLI 访问 chatgpt.com 失败时使用）
# 示例：http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1

# 时区
TIMEZONE=Asia/Shanghai

# 缓存秒数，避免频繁启动 codex app-server
CACHE_SECONDS=20

# SQLite 数据库路径
DB_PATH=codex_quota_radar_bot.sqlite3

# 后台检查 Codex 低额度的间隔，单位分钟
CHECK_INTERVAL_MINUTES=15
# 后台额度检查失败时是否推送错误到 Telegram；默认 0，避免上游网络波动刷屏
WATCH_NOTIFY_ERRORS=0

# 是否允许 /raw 输出原始 JSON
ENABLE_RAW=0

# Codex Radar RSS
RADAR_FEED_URL=https://codexradar.com/feed.xml
RADAR_CHECK_INTERVAL_MINUTES=3
RADAR_BOOTSTRAP_SILENT=1

# 图表输出配置
CHART_MAX_POINTS=300
